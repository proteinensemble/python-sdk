{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "contentHash",
    "topologyReference",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0",
      "description": "The current manifest schema version."
    },
    "id": {
      "type": "string",
      "description": "Unique ensemble ID."
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+:[a-fA-F0-9]+$",
      "description": "Content hash in the format algorithm:hexdigest."
    },
    "topologyReference": {
      "type": "object",
      "description": "Identifies the topology against which ensemble members are interpreted.",
      "oneOf": [
        {
          "required": ["memberId"],
          "properties": {
            "memberId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["externalReference"],
          "properties": {
            "externalReference": {
              "type": "object",
              "required": ["uri"],
              "properties": {
                "uri": {
                  "type": "string",
                  "format": "uri-reference"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "weightScheme": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EQUILIBRIUM_PROBABILITY",
            "CLUSTER_FRACTION",
            "EXPERIMENTAL_OCCUPANCY",
            "UNIFORM",
            "CUSTOM"
          ]
        },
        "normalized": {
          "type": "boolean"
        },
        "customSemantics": {}
      },
      "if": {
        "properties": {
          "type": {
            "const": "CUSTOM"
          }
        }
      },
      "then": {
        "required": ["customSemantics"]
      }
    },
    "capabilitiesRequired": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["STANDALONE_CIF"]
    },
    "metadata": {
      "type": "object",
      "description": "Opaque passthrough for metadata."
    },
    "dynamics": {
      "type": "object",
      "description": "Opaque passthrough for dynamics."
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "structure"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Unique member ID matching alphanumeric, hyphen, and underscore characters."
          },
          "structure": {
            "type": "object",
            "oneOf": [
              {
                "title": "Standalone",
                "required": ["uri"],
                "properties": {
                  "uri": {
                    "type": "string",
                    "format": "uri-reference"
                  }
                },
                "additionalProperties": false
              },
              {
                "title": "Multi-model",
                "required": ["uri", "modelIndex"],
                "properties": {
                  "uri": {
                    "type": "string",
                    "format": "uri-reference"
                  },
                  "modelIndex": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              {
                "title": "Trajectory-backed",
                "required": [
                  "topologyUri",
                  "trajectoryUri",
                  "frameIndex",
                  "trajectoryFormat"
                ],
                "properties": {
                  "topologyUri": {
                    "type": "string",
                    "format": "uri-reference"
                  },
                  "trajectoryUri": {
                    "type": "string",
                    "format": "uri-reference"
                  },
                  "frameIndex": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "trajectoryFormat": {
                    "type": "string",
                    "enum": ["XTC", "DCD", "TRR", "NC"]
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "weight": {
            "type": "object",
            "required": ["value"],
            "properties": {
              "value": {
                "type": "number"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "residueMapping": {
            "type": "object",
            "required": ["uri"],
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri-reference"
              },
              "format": {
                "type": "string"
              }
            }
          },
          "thermodynamics": {
            "type": "object",
            "description": "Opaque passthrough for thermodynamics."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
